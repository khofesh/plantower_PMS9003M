[Unit]
Description=PMS9003M PM2.5 web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and paths to match your install.
User=fahmi
WorkingDirectory=/home/fahmi/plantower_PMS9003M/raspi_python_PMS9003M
ExecStart=/usr/bin/python3 /home/fahmi/plantower_PMS9003M/raspi_python_PMS9003M/dashboard.py \
    --db /home/fahmi/plantower_PMS9003M/raspi_python_PMS9003M/pm25.db --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
